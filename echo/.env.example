# Copy this file to .env and fill in your keys.
# Without keys Echo runs in demo mode.

# Claude (chat) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Image creation (OpenAI images API) - https://platform.openai.com
OPENAI_API_KEY=

# Optional overrides
# ECHO_MODEL=claude-opus-5-5
# ECHO_EFFORT=medium
# ECHO_IMAGE_MODEL=gpt-image-1
# ECHO_PORT=8000
